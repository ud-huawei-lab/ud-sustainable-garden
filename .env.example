HOST=127.0.0.1
PORT=5173
HA_URL=https://jnjtt9at8pwjtctcunrwlvs2mdegtpbf.ui.nabu.casa
HA_TOKEN=
# Alternatively, use an existing HA account. Tokens remain in server memory.
HA_USERNAME=
HA_PASSWORD=
# Required by npm start and every deployment. npm run dev on loopback skips sign-in.
# Run npm run auth:setup.
APP_USERNAME=
APP_PASSWORD_HASH=
# Generated by npm run auth:setup. Required for Vercel's encrypted login cookies.
APP_SESSION_SECRET=
# Required for remote binding. HTTPS origin only, without a trailing slash.
APP_ORIGIN=
# Set to loopback only when a trusted local reverse proxy terminates HTTPS.
TRUST_PROXY=
# Optional direct InfluxDB v1 connection; HA history is used otherwise.
INFLUX_URL=
INFLUX_DATABASE=homeassistant
INFLUX_USERNAME=
INFLUX_PASSWORD=
GRAFANA_URL=

# Server-only authenticated DGX vision gateway. Never use a VITE_ prefix.
AI_BRIDGE_URL=
AI_BRIDGE_TOKEN=

# Server-only DGX plant measurements. Locally: ssh -f -N -L 8771:127.0.0.1:8771 dgx
GROWTH_URL=
GROWTH_TOKEN=
# Pot width in cm at the widest point. Sets the scale for every saved night.
POT_LEFT_WIDTH_CM=60
POT_RIGHT_WIDTH_CM=60
