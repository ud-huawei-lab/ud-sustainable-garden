HOST=127.0.0.1
PORT=5173
HA_URL=https://your-home-assistant.example
HA_TOKEN=
# Alternatively, use an existing HA account. Tokens remain in server memory.
HA_USERNAME=
HA_PASSWORD=
# Required on all interfaces, including localhost. Run npm run auth:setup.
APP_USERNAME=
APP_PASSWORD_HASH=
# Required for remote binding. HTTPS origin only, without a trailing slash.
APP_ORIGIN=
# Set to loopback only when a trusted local reverse proxy terminates HTTPS.
# On Render, use 1 for its single trusted edge proxy; do not expose Node directly.
TRUST_PROXY=
# Vercel only: HTTPS origin of the deployed Node backend. No credentials here.
GARDEN_BACKEND_ORIGIN=
# Optional direct InfluxDB v1 connection; HA history is used otherwise.
INFLUX_URL=
INFLUX_DATABASE=homeassistant
INFLUX_USERNAME=
INFLUX_PASSWORD=
GRAFANA_URL=
